	<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
		<PropertyGroup>
			<ProjectGuid>{DE38688C-0643-4FFF-866E-240DAAECE07F}</ProjectGuid>
		</PropertyGroup>
		<ItemGroup>
			<Projects Include="client\src\chipup_client.dproj">
				<Dependencies/>
			</Projects>
			<Projects Include="client\tests\clientTests.dproj">
				<Dependencies/>
			</Projects>
			<Projects Include="protocopier\src\protocopier.dproj">
				<Dependencies/>
			</Projects>
		</ItemGroup>
		<ProjectExtensions>
			<Borland.Personality>Default.Personality.12</Borland.Personality>
			<Borland.ProjectType/>
			<BorlandProject>
				<Default.Personality/>
			</BorlandProject>
		</ProjectExtensions>
		<Target Name="chipup_client">
			<MSBuild Projects="client\src\chipup_client.dproj"/>
		</Target>
		<Target Name="chipup_client:Clean">
			<MSBuild Targets="Clean" Projects="client\src\chipup_client.dproj"/>
		</Target>
		<Target Name="chipup_client:Make">
			<MSBuild Targets="Make" Projects="client\src\chipup_client.dproj"/>
		</Target>
		<Target Name="clientTests">
			<MSBuild Projects="client\tests\clientTests.dproj"/>
