doctype html
html
  body
    include header
    block content
      table(border=1)
        tr
          th date
          th from
          th subject
          th body
        tr
          td=new Date((new Buffer(bug._id.toString(),'hex').readUInt32BE(0))*1000)
          td=bug.MailFrom
          td=bug.MailSubject
          td=bug.MailBody
      pre=bug.BugReport
      img(src='/screenshot?id='+bug._id)
