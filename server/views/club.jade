extends secure
block content
  table(border=1)
    tr
      th name
    tr
      td=club.name
  table(border=1)
    tr
      th member name
    tr
      td
        a(href="/secure/user?id="+club.owner)=users[club.owner].displayname
    each member in club.members
      tr
        td
          a(href="/secure/user?id="+member)=users[member].displayname
  table(border=1)
    tr
      th name
      th SB/BB
      th seats
    each val in games
      tr
        td
          a(href="/secure/game?id="+val._id)=val.gamename
        td=val.small_blind/100+'/'+val.big_blind/100
        td=val.seats
  if club.is_private
    div
      form(method="post",action="/secure/club_public")
        input(type="hidden",name="clubid",value=club._id)
        input(type="submit",value="publish")
  else
    div public
