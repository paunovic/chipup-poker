extend secure
block content
  table(border=1)
    tr
      th ts
      th type
      th username
      th email
    each report in reports
      tr
        td
          a(href='/secure/reports?close='+report._id) X
          span=' '+report._id.getTimestamp()
        td=report.reason
        td=users[report.userid].displayname
        td
          a(href='mailto:'+users[report.userid].email+'?cc=poker@chipuppoker.com')=users[report.userid].email
      tr
        td(colspan=4)
          pre=report.message
