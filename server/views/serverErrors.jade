extends secure
block content
  table(border=1)
    tr
      th ts
      th msg
      th trace
      th trace2
    each row in rows
      tr
        td
          span=row._id.getTimestamp()
          a(href="/secure/serverBugs?delete="+row._id) X
        td=row.error
        td
          pre=row.trace
        td
          pre=row.trace2
