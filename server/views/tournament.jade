extends secure
block header
  script(src='/tournament.js')
block content
  form(method="post")
    table(border=1)
      tr
        th name
        td=tourn.name
      tr
        th sb/bb
        td=tourn.sb+'/'+tourn.bb
      tr
        th blind schedule
        td
          table(border=1)
            tr
              th level
              th SB/BB
            each blind,level in tourn.blind_schedule.blinds
              tr
                td=level+1
                td=blind.sb+'/'+blind.bb
      tr
        th state
        td
          select(name="state")
            option(selected=tourn.state == 'tnsOpen',value='tnsOpen') open
            option(selected=tourn.state == 'tnsInProgress',value='tnsInProgress') in-progress
            option(selected=tourn.state == 'tnsCancelled',value='tnsCancelled') cancelled
      tr
        th reset chips?
        td
          input(type="checkbox",name="resetChips")
    input(type="submit")
  each log,idx in logs
    p
      a(href="#",onclick="downloadLog('"+log._id+"',this);return false")='open log #'+idx+'('+log.records.length+' items)'
      | or
      a(href="#",onclick="loopLog('"+log._id+"',this);return false")=' loop log'
