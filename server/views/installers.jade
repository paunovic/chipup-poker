extends secure
block content
  if showlist
    form(method="post")
      p Release builds:
      table(border=1)
        tr
          th ts
          th links
          th version
          th revision
          th size
          th activate
          th status/delete
        each val in installers
          if val.debug == 'release'
            include installer_row.jade
      p Debug builds:
      table(border=1)
        tr
          th ts
          th links
          th version
          th revision
          th size
          th activate
          th status/delete
        each val in installers
          if val.debug == 'debug'
            include installer_row.jade
      input(type="submit",value="Apply")
  div
    div='version:'+activeRelease.version
    div='revision:'+activeRelease.revision
    div='size:'+(activeRelease.size/1024/1024)+'MB'
    a(href="/rawinstallers/"+activeRelease.name) raw installer
  form(method="post",action="/secure/newVersion",enctype="multipart/form-data")
   div
     | installer:
     input(type="file",name="installer")
   div
     | version:
     input(type="text",name="version")
   div
     | git revision:
     input(type="text",name="revision")
   input(type="hidden",name="debug",value="release")
   input(type="submit",value="upload")
