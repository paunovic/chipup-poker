extends secure
block header
  script(src="/socket.io/socket.io.js")
  script(src="/installers.js")
block content
  if showlist
    form(method="post")
      p Release builds:
      table(border=1,id="release_installers")
        tr
          th ts
          th links
          th version
          th revision
          th size
          th activate
          th status/delete
          th used by
        each val in installers
          if val.debug == 'release'
            include installer_row.jade
      p Debug builds:
      table(border=1,id="debug_installers")
        tr
          th ts
          th links
          th version
          th revision
          th size
          th activate
          th status/delete
          th used by
        each val in installers
          if val.debug == 'debug'
            include installer_row.jade
      input(type="button",onclick="masscheck()",value="checkEverything")
      br
      input(type="submit",value="Apply")
  div
    div='version:'+activeRelease.version
    div='revision:'+activeRelease.revision
    div='size:'+(activeRelease.size/1024/1024)+'MB'
    a(href="/rawinstallers/"+activeRelease.name) raw installer
  if diffserver
    div(style="border: 1px solid red")
      form(method="post",action="/secure/newVersion",enctype="multipart/form-data")
       div
         | installer:
         input(type="file",name="installer")
       div
         | version:
         input(type="text",name="version")
       div
         | git revision:
         input(type="text",name="revision")
       input(type="hidden",name="debug",value="release")
       p always set to release mode
       input(type="submit",value="upload")
    div(style="border: 1px solid red")
      | buildbot controls
      pre(id="lastMsg")=latestMsg
      input(id="buildButton",type="button",value="build!",onclick="buildRevision('" +revision+ "')")
  div(id="diffs")
