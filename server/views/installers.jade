extends secure
block header
  script(src="/socket.io/socket.io.js")
  script(src="/installers.js")
block content
  br
  h1(style="text-align: center")
   a(href='installers?appcode=acDelphiWindows') Windows
   div(class="divider15px")
   a(href='installers?appcode=acQtMac') MAC
  if showlist
    form(method="post")
      h2(style="text-align: center") Release builds
      table(border=1,id="release_installers",class="installers")
        tr
          th TIMESTAMP
          th VERSION
          th REVISION
          th SIZE
          th ACTIVATE
          th STATUS/DELETE
          th DIFF SOURCE
          th DIFF DEST
          th USED BY
        each val in installers
          if (val.debug == 'release') && (val.appcode == appcode)
            include installer_row.jade
      h2(style="text-align: center") Debug builds
      table(border=1,id="debug_installers",class="installers")
        tr
          th TIMESTAMP
          th VERSION
          th REVISION
          th SIZE
          th ACTIVATE
          th STATUS/DELETE
          th DIFF SOURCE
          th DIFF DEST
          th USED BY
        each val in installers
          if (val.debug == 'debug') && (val.appcode == appcode)
            include installer_row.jade
      br
      div
        input(type="button",onclick="masscheck()",value="Check everything")
        div(class="divider5px")
        input(type="button",onclick="checkLatest()",value="Check latest")
        div(class="divider5px")
        input(type="submit",value="Apply",style="float: right;")
        if diffserver
          div(class="divider5px")
          span(id="makeDiff",style="display:none")
            input(type="button",value="Make diff",onclick="makeDiff2()")
  br
  div
    h1 Buildbot
    pre(id="lastMsg")=latestMsg
    input(id="buildButton",type="button",value="Build",onclick="buildRevision('" +revision+ "')")
