extends secure
block content
  script.
    var raw=!{JSON.stringify(user)};
  p="player is "+(online ?"on":"off")+"line"
  table(border=1)
    tr
      th name
      th chips
    tr
      td=user.displayname
      td=user.chips
  table(border=1)
    tr
      th club name
    each val in clubs
      tr
        td
          a(href='/secure/club?id='+val._id)=val.name
