extends base
block content
  script.
    var raw=!{JSON.stringify(hand)};
  p='rake:'+hand.rake+'%' + (hand.totalrake ? '=='+hand.totalrake/100 : '')
  a(href='/game?id='+hand.gameid) parent game
  table(border=1)
    tr
      th location
      th cards
    each set,idx in hand.cards
      if set
        tr
          if idx == 0
            td flop
          else if idx == 1
            td turn
          else if idx == 2
            td river
          else
            td='seat#'+(idx-3)
          td=set
  table(border=1)
    tr
      th seat#
      th player mongoid
      th balance
    each player,idx in hand.players
      if player
        tr
          td=idx
          td
            a(href="/user?id="+player._id)=player._id
          td=hand.balance_changes ? hand.balance_changes[idx]/100 : ''
  table(border=1)
    tr
      th move#
      th seat
      th bet
      th code
      th trace
    each move,idx in hand.moves
      tr
        td=idx
        td=move.seat
        td=move.bet
        td=move.code
        td
          pre=move.trace
