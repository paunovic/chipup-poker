extends secure
block content
  table(border=1)
    tr
      th date registered
      th club name
      th seq
      th rake&max
    each val in clubs
      tr
        td=val._id.getTimestamp()
        td
          a(href='/secure/club?id='+val._id)=val.name
        td=val.seq
        td=val.rake+'% '+val.max_rake_per_hand
