extends secure
block content
  form(method="post")
    input(type="text",placeholder="name",name="name")
    br
    textarea(placeholder="description",name="notes",rows="8",cols="40")
    br
    select(name="gametype")
      option(value="gtHoldem") Holdem
      option(value="gtOmaha") Omaha
      option(value="gtRotationNLHPLO") NL/PLO Rotation
    br
    select(name="limit")
      option(value="glNoLimit") no limit
      option(value="glPotLimit") pot limit
    br
    select(name="seats")
      option(value="2") 2
      option(value="3") 3
      option(value="4") 4
      option(value="5") 5
      option(value="6") 6
      option(value="7") 7
      option(value="8") 8
      option(value="9") 9
    br
    input(type="text",name="minplayers",placeholder="min players")
    input(type="text",name="maxplayers",placeholder="max players")
    br
    input(type="text",name="startingchips",placeholder="starting chips")
    br
    input(type="text",name="timeperlevel",placeholder="minutes per level")
    br
    | blind structure
    br
