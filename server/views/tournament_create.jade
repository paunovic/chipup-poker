extends secure
block header
  link(rel="stylesheet",type="text/css",href="/css/calendarview.css")
  script(src="/js/jquery-1.11.1.min.js")
  script(src="/js/prototype.js")
  script(src="/js/jquery.timepicker.js")
  script(src="/js/calendarview.js")
block header2
  script.
    jQuery(document).ready(function ($) {
      Calendar.setup({dateField:'dateField'});
      $('#timeField').timepicker();
    });
block content
  form(method="post")
    | name:
    input(type="text",name="name")
    br
    textarea(placeholder="description",name="description",rows="8",cols="40")
    br
    select(name="gametype")
      option(value="gtHoldem") Holdem
      option(value="gtOmaha") Omaha
      option(value="gtRotationNLHPLO") NL/PLO Rotation
    br
    select(name="limit")
      option(value="glNoLimit") no limit
      option(value="glPotLimit") pot limit
    br
    | seats:
    select(name="seats_per_table")
      option(value="2") 2
      option(value="3") 3
      option(value="4") 4
      option(value="5") 5
      option(value="6") 6
      option(value="7") 7
      option(value="8") 8
      option(value="9") 9
    br
    | Players min:
    input(type="text",name="minplayers")
    | Max:
    input(type="text",name="maxplayers")
    br
    | Starting Chips:
    input(type="text",name="startingchips")
    br
    | Minutes per level:
    input(type="text",name="timeperlevel")
    br
    | blind structure
    br
    | Start time:
    input(type="text",id="dateField",class="dateField",value="Date",name="start_date")
    input(type="text",id="timeField",name="start_time")
    br
    input(type="submit",value="Create!")
    br
