doctype html
html
  body
    include header
    block content
      table(border=1)
        tr
          th date registered
          th name
          th chips
        each val in users
          tr
            td=new Date((new Buffer(val._id.toString(),'hex').readUInt32BE(0))*1000)
            td
              a(href='/user?id='+val._id)=val.displayname
            td=val.chips
