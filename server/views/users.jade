doctype html
html
  body
    include header
    block content
      table(border=1)
        tr
          th date registered
          th name
          th chips
        each val in users
          tr
            td=val._id.getTimestamp()
            td
              a(href='/user?id='+val._id)=val.displayname
            td=val.chips
      div=sum/100
    include footer
