tr
  td=val._id.getTimestamp()
  td
    a(href="/rawinstallers/"+val.name) installer
  td=val.version
  td=val.revision
  td=Math.round(val.size/1024/1024)+'MB'
  td
    input(type="radio",name="activate_"+val.debug,value=val._id)
  td
    if (val.debug == 'release') && (pubver.toString() == val._id.toString())
      | Public Version
    else if (val.debug == 'debug') && (debugver.toString() == val._id.toString())
      | Debug Version
    else
      input(class='deleteCheckbox',type="checkbox",name="delete_"+val._id)
