tr
  td=val.name
  td=val.version
  td=val.revision
  td=val.debug
  td=Math.round(val.size/1024/1024)+'MB'
  td
    if (pubver.toString() == val._id.toString())
      | Public Version
    else
      form(method="post")
        input(name="setpublic",value=val._id,type="hidden")
        input(type="submit",value="Activate")
      form(method="post")
        input(name="delete",value=val._id,type="hidden")
        input(type="submit",value="Delete")
