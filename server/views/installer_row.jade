tr
  td
    script="document.write(formatDate(new Date('" + val._id.getTimestamp().toJSON() + "')))"
  td
    a(href="https://dev-server.chipuppoker.com/rawinstallers/"+val.name)=val.version
  td(class="revision")=val.revision
  td=(val.size/1024/1024).toFixed(2) +'MB'
  td
    input(type="radio",name="activate_dev_"+val.debug,value=val._id,class="activate")
  td
    input(type="radio",name="activate_live_"+val.debug,value=val._id,class="activate")
  td
    if (val.debug == 'release')
      if (dev_pubver == live_pubver) && (dev_pubver == val._id)
        | DEV & LIVE
      else if (dev_pubver == val._id)
        | DEV
      else if (live_pubver == val._id)
        | LIVE
      else
        input(class='deleteCheckbox',type="checkbox",name="delete_"+val._id)
    else if (val.debug == 'debug')
      if (dev_debugver == live_debugver) && (dev_debugver == val._id)
        | DEV & LIVE
      else if (dev_debugver == val._id)
        | DEV
      else if (live_debugver == val._id)
        | LIVE
      else
        input(class='deleteCheckbox',type="checkbox",name="delete_"+val._id)
  td
    if (val.hashes)
      input(type="radio",name="diff_source",onchange="changeSource('"+val.hashes['chipuppoker:exe']+"')")
    else
      | corrupt installer
  td
    if (val.hashes)
      input(type="radio",name="diff_dest",onchange="changeDest('"+val.hashes['chipuppoker:exe']+"')")
    else
      | corrupt installer
  td(style="text-align: right;")=val.used_by
